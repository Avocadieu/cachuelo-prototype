# ─── Supabase ─────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API. La anon key es pública por diseño:
# la seguridad real es RLS. NUNCA pongas aquí la service_role key.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# true: usa el mundo simulado (perfil v0.18, portafolio, Mis cachuelos) aunque
# arriba haya un Supabase real. El login sigue siendo real. Quitar al conectar datos.
VITE_DEMO_MODE=false

# ─── Google Maps (opcional) ───────────────────────────────────────────────────
# Sin estas variables la app funciona igual: la pestaña Mapa muestra
# "Explorar por zona". Ver docs/cambios/CAMBIOS_v0.15.md → "Activar el mapa".
VITE_GOOGLE_MAPS_API_KEY=
# Map ID propio (Google Cloud → Map Management). Si lo dejas vacío se usa
# DEMO_MAP_ID, que sirve solo para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=

# ─── Pagos ────────────────────────────────────────────────────────────────────
# demo (por defecto): flujo completo SIN dinero real (se guarda en el navegador).
# live: usa la Edge Function `payments` + Culqi. Solo cuando esté todo listo.
VITE_PAYMENTS_MODE=demo
# Llave PÚBLICA de Culqi (pk_test_… / pk_live_…). La SECRETA va solo en:
#   supabase secrets set CULQI_SECRET_KEY=sk_test_…
VITE_CULQI_PUBLIC_KEY=

# ─── Verificación de identidad ────────────────────────────────────────────────
# demo (por defecto): documentos guardados solo en el navegador, para probar.
# live: bucket privado `verificaciones` en Supabase (correr migración v0.17).
VITE_VERIFICATION_MODE=demo
